// =============================================================================
// DBO shared styles (images in data/images/dbo, generated by tools/gen_hud_art.py)
// =============================================================================

DboLabel < Label
  font: verdana-11px-rounded
  color: #f2e2c0
  text-auto-resize: true

DboTitle < Label
  font: verdana-11px-rounded
  color: #ffd27a
  text-auto-resize: true

DboSmall < Label
  font: verdana-11px-rounded
  color: #c8b89a
  text-auto-resize: true

DboButton < UIButton
  font: verdana-11px-rounded
  color: #fff4dc
  size: 96 24
  text-offset: 0 0
  image-source: /images/dbo/button
  image-border: 6
  $hover !disabled:
    image-source: /images/dbo/button_hover
  $pressed:
    text-offset: 1 1
  $disabled:
    image-source: /images/dbo/button_disabled
    color: #9a9080

DboBlueButton < DboButton
  image-source: /images/dbo/button_blue
  $hover !disabled:
    image-source: /images/dbo/button_blue
    opacity: 0.85

DboCloseButton < UIButton
  size: 18 18
  text: x
  font: verdana-11px-rounded
  color: #ffd27a
  background-color: #00000000
  $hover:
    color: #ffffff

DboWindow < UIWindow
  image-source: /images/dbo/panel
  image-border: 10
  padding: 34 12 12 12
  draggable: true
  focusable: true
  phantom: false
  @onEscape: self:hide()

  UIWidget
    id: header
    image-source: /images/dbo/header
    image-border: 4
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: -31 -9 0 -9
    height: 26
    phantom: true

  Label
    id: windowTitle
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: -26
    font: verdana-11px-rounded
    color: #ffe9b0
    text-auto-resize: true
    phantom: true

  DboCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -29
    margin-right: -6
    @onClick: self:getParent():hide()

DboCard < UIWidget
  background-color: #1c120ecc
  border-width: 1
  border-color: #7a5420
  padding: 6

DboStarRow < UIWidget
  size: 64 12
  UIWidget
    id: star1
    size: 12 12
    anchors.left: parent.left
    anchors.top: parent.top
    image-source: /images/dbo/star_small_empty
  UIWidget
    id: star2
    size: 12 12
    anchors.left: prev.right
    anchors.top: parent.top
    margin-left: 1
    image-source: /images/dbo/star_small_empty
  UIWidget
    id: star3
    size: 12 12
    anchors.left: prev.right
    anchors.top: parent.top
    margin-left: 1
    image-source: /images/dbo/star_small_empty
  UIWidget
    id: star4
    size: 12 12
    anchors.left: prev.right
    anchors.top: parent.top
    margin-left: 1
    image-source: /images/dbo/star_small_empty
  UIWidget
    id: star5
    size: 12 12
    anchors.left: prev.right
    anchors.top: parent.top
    margin-left: 1
    image-source: /images/dbo/star_small_empty

DboProgress < UIWidget
  height: 10
  background-color: #0a0606dd
  border-width: 1
  border-color: #6b4a1e
  UIWidget
    id: fill
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin: 1
    width: 0
    background-color: #e8a028
  Label
    id: text
    anchors.centerIn: parent
    font: verdana-11px-rounded
    color: #ffffff
    text-auto-resize: true

DboField < TextEdit
  height: 22
  anchors.left: parent.left
  anchors.right: parent.right

DboAccountWindow < DboWindow
  size: 300 286
  anchors.centerIn: parent
  draggable: false

  DboSmall
    !text: tr('E-mail (login)')
    anchors.top: parent.top
    anchors.left: parent.left
  DboField
    id: email
    anchors.top: prev.bottom
    margin-top: 2
  DboSmall
    !text: tr('Senha (minimo 6)')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
  DboField
    id: password
    anchors.top: prev.bottom
    margin-top: 2
    text-hidden: true
  DboSmall
    !text: tr('Repita a senha')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
  DboField
    id: repeatPassword
    anchors.top: prev.bottom
    margin-top: 2
    text-hidden: true
  DboSmall
    !text: tr('Nome do personagem')
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 8
  DboField
    id: name
    anchors.top: prev.bottom
    margin-top: 2
  Label
    id: status
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 28
    font: verdana-11px-rounded
    text-wrap: true
  DboButton
    id: create
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    !text: tr('Criar')
